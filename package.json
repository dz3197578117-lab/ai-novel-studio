{
  "name": "novelforge",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "AI 长篇小说创作工作台 —— 本地 Web 应用",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @novelforge/server dev",
    "dev:web": "pnpm --filter @novelforge/web dev",
    "build": "pnpm --filter @novelforge/web build",
    "start": "pnpm --filter @novelforge/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @novelforge/server test",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:library": "node scripts/e2e-library.mjs",
    "test:e2e:draft": "node scripts/e2e-draft.mjs",
    "test:e2e:settings": "node scripts/e2e-settings.mjs",
    "test:e2e:consistency": "node scripts/e2e-consistency.mjs",
    "test:e2e:interaction": "node scripts/e2e-interaction.mjs",
    "test:e2e:write": "node scripts/e2e-write.mjs",
    "test:scroll": "node scripts/diagnose-scroll.mjs",
    "push": "node scripts/push.mjs",
    "mock:llm": "node scripts/mock-llm.mjs",
    "seed": "pnpm --filter @novelforge/server seed",
    "clean": "node scripts/clean.mjs",
    "test:e2e:plan-apply": "node scripts/e2e-plan-apply.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "build:exe:linux": "node scripts/build-exe.mjs --target=linux-x64",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:desktop:linux": "node scripts/build-desktop.mjs --linux"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "postject": "1.0.0-alpha.6",
    "typescript": "^5.7.2"
  }
}
